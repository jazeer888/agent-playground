# Copy to .env (same folder) and fill in. .env is git-ignored.

# Where the key was created decides the mode; a mismatch gives
# 403 API_KEY_SERVICE_BLOCKED.
#   0 = Google AI Studio key (aistudio.google.com)
#   1 = Vertex AI express key (Google Cloud console)
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-key-here

# Optional: override the model (default gemini-3.5-flash).
# SUPPORT_AGENT_MODEL=gemini-3.5-flash
